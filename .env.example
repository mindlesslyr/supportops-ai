# Copy to .env and replace every REQUIRED value with a unique random secret.
EMBEDDING_BACKEND=hash
EMBEDDING_DIMENSIONS=384
ANSWER_PROVIDER=context
# ANSWER_PROVIDER=openai requires OPENAI_API_KEY.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=500

# REQUIRED by Docker Compose. Generate, for example: openssl rand -hex 32
API_KEY=REPLACE_WITH_RANDOM_API_KEY
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
N8N_INBOUND_TOKEN=REPLACE_WITH_RANDOM_N8N_INBOUND_TOKEN
N8N_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY

# Development-only escape hatch. Keep false outside isolated tests.
ALLOW_UNSIGNED_WEBHOOKS_DEV=false
APP_ENVIRONMENT=development
ENABLE_API_DOCS=true
MAX_REQUEST_BODY_BYTES=262144
WEBHOOK_LEASE_SECONDS=60
LOW_CONFIDENCE_THRESHOLD=0.20
QDRANT_STARTUP_ATTEMPTS=5
QDRANT_RETRY_SECONDS=0.5
